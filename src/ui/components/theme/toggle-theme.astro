---
import { Moon, Sun } from "@lucide/astro";
---

<button class="btn btn-xl btn-ghost btn-circle" data-toggle-theme="coffee,autumn" data-act-class="ACTIVECLASS">
  <label class="swap dark:swap-active">
    <Sun  class="swap-off" size={44}/>
    <Moon class="swap-on"  size={44}/>
  </label>
</button>